JWT_SECRET=your-secret-here

# Database (Neon Postgres)
DATABASE_URL=postgres://user:pass@host/db
CRON_SECRET=

# Microsoft Graph (Calendar today; SharePoint data rooms after Ethan's
# Entra Files/Sites consent — see lib/storage/sharepoint.ts)
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Document storage (Phase 3). Provider: "local" (interim app-managed
# disk store) or "sharepoint" (only after the Entra consent above).
STORAGE_PROVIDER=local
# Optional override for the interim local store root.
DATAROOM_STORAGE_DIR=
